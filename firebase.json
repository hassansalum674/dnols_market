{
  "hosting": [
    {
      "target": "buyer",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "CDN-Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Cloudflare-CDN-Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "CDN-Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Cloudflare-CDN-Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/index.html",
