{
  "name": "dnols",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dnols — Tanzania shop marketplace PWA",
  "scripts": {
    "dev": "node --require ./scripts/crypto-polyfill.cjs ./node_modules/vite/bin/vite.js",
    "build": "tsc -b && node --require ./scripts/crypto-polyfill.cjs ./node_modules/vite/bin/vite.js build",
    "preview": "node --require ./scripts/crypto-polyfill.cjs ./node_modules/vite/bin/vite.js preview",
    "icons": "node scripts/generate-icons.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@fontsource/playfair-display": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vite-plugin-pwa": "^0.21.2"
  }
}
