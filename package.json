{
  "name": "dnols",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dnols — Tanzania shop marketplace PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "VITE_API_URL=https://dnols-83jj.onrender.com npm run build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "firebase:login": "firebase login",
    "firebase:use": "firebase use --add",
    "firebase:serve": "firebase emulators:start --only hosting:buyer",
    "firebase:deploy:buyer": "npm run build:prod && firebase deploy --only hosting:buyer --project dnols-2a394",
    "firebase:deploy:shop": "cd shop && VITE_API_URL=https://dnols-83jj.onrender.com npm run build && cd .. && firebase deploy --only hosting:shop --project dnols-2a394",
    "firebase:deploy": "npm run firebase:deploy:buyer && npm run firebase:deploy:shop",
    "deploy": "bash scripts/deploy.sh"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@fontsource/playfair-display": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vite-plugin-pwa": "^0.21.2"
  }
}
