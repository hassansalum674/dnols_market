rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function riderDoc(riderId) {
      return get(/databases/$(database)/documents/riders/$(riderId)).data;
    }

    function isLinkedSeller(data) {
      return signedIn() && request.auth.uid in data.linkedSellers;
    }

    function isThisRider(data) {
      return signedIn() && (
        data.authUid == request.auth.uid ||
        data.phone == request.auth.token.phone
      );
    }

    function isOrderParty() {
      return signedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        request.auth.uid in resource.data.sellerIds
      );
    }

    function isAssignedRider() {
      return signedIn()
        && resource.data.riderId is string
        && exists(/databases/$(database)/documents/riders/$(resource.data.riderId))
        && (
          riderDoc(resource.data.riderId).authUid == request.auth.uid ||
          riderDoc(resource.data.riderId).phone == request.auth.token.phone ||
          resource.data.riderAuthUid == request.auth.uid
        );
    }

    function callStatusOk() {
      return !('callStatus' in request.resource.data)
        || request.resource.data.callStatus in ['idle', 'calling', 'in_call', 'ended'];
    }

    function callInitiatorOk() {
      return !('callInitiatedBy' in request.resource.data)
        || request.resource.data.callInitiatedBy == null
        || request.resource.data.callInitiatedBy is string;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /orders/{orderId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /sellers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /riders/{riderId} {
      allow read: if signedIn() && (
        isThisRider(resource.data) || isLinkedSeller(resource.data)
      );
      allow create: if signedIn()
        && request.resource.data.riderId == riderId
        && request.auth.uid in request.resource.data.linkedSellers;
      allow update: if signedIn() && (
        isLinkedSeller(resource.data) || isThisRider(resource.data)
      );
    }

    match /seller_riders/{linkId} {
      allow read: if signedIn() && (
        resource.data.sellerId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/riders/$(resource.data.riderId)) &&
          isThisRider(riderDoc(resource.data.riderId))
        )
      );
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if signedIn() && resource.data.sellerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if isOrderParty() || isAssignedRider();
      allow create: if signedIn()
        && request.resource.data.orderId == orderId
        && (
          request.resource.data.buyerUid == request.auth.uid ||
          request.auth.uid in request.resource.data.sellerIds
        );
      allow update: if (isOrderParty() || isAssignedRider())
        && callStatusOk()
        && callInitiatorOk();
    }
  }
}
