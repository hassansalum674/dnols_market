# Server
PORT=8787
HOST=0.0.0.0

# CORS: * allows any origin (Vite on localhost:5173, etc.)
CORS_ORIGIN=*

# Public URL of this API (Render). Used for absolute CDN image URLs.
# Example: https://dnols-83jj.onrender.com
API_PUBLIC_URL=

# FAPIhub background removal (cover photos). Set on Render → Environment.
FAPIAPI_API_KEY=

# Listing-description AI (seller “Ask the AI”). Prefer Claude.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional fallbacks if FAPIhub is not configured
# REMOVEBG_API_KEY=
# CLIPDROP_API_KEY=

# Default buyer pin used to compute distanceMeters (Kariakoo market area).
BUYER_LAT=-6.8224
BUYER_LNG=39.2739
