# Server
PORT=8787
HOST=0.0.0.0

# CORS: * allows any origin (Vite on localhost:5173, etc.)
CORS_ORIGIN=*

# Public URL of this API (Render). Used for absolute CDN image URLs.
# Example: https://dnols-83jj.onrender.com
API_PUBLIC_URL=

# Google Gemini — AI cover photos (Imagen) + text fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Groq — fast description assist (preferred for text)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic — description assist fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_MAX_TOKENS=512

# OpenAI — optional alternative (DALL·E 3 + GPT)
OPENAI_API_KEY=

# FAPIhub background removal (cover photos). Set on Render → Environment.
FAPIAPI_API_KEY=

# Optional fallbacks if FAPIhub is not configured
# REMOVEBG_API_KEY=
# CLIPDROP_API_KEY=

# Default buyer pin used to compute distanceMeters (Kariakoo market area).
BUYER_LAT=-6.8224
BUYER_LNG=39.2739
