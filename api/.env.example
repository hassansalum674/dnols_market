# Server
PORT=8787
HOST=0.0.0.0

# CORS: * allows any origin (Vite on localhost:5173, etc.)
CORS_ORIGIN=*

# Public URL of this API (Render). Used for absolute CDN image URLs.
# Example: https://dnols-83jj.onrender.com
API_PUBLIC_URL=

# FAPIhub background removal (cover photos). Set on Render → Environment.
FAPIAPI_API_KEY=

# Optional fallbacks if FAPIhub is not configured
# REMOVEBG_API_KEY=
# CLIPDROP_API_KEY=

# Default buyer pin used to compute distanceMeters (Kariakoo market area).
BUYER_LAT=-6.8224
BUYER_LNG=39.2739

# Rider invite SMS (Africa's Talking). Without these, invites still save; SMS is skipped.
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_FROM=DNOLS

# Used to check the seller's Firebase token on POST /riders/invite
# FIREBASE_WEB_API_KEY=
# FIREBASE_PROJECT_ID=dnols-2a394

# In-app rider ↔ buyer voice calls (Agora). Certificate stays server-side.
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=
